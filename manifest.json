{
  "manifest_version": 3,
  "name": "一键更新书签",
  "version": "1.0.0",
  "description": "按下快捷键，将选定书签的网址更新为当前网页。",
  "permissions": ["bookmarks", "storage", "activeTab"],
  "icons": {
    "16": "icons/bookmark-16.png",
    "32": "icons/bookmark-32.png",
    "48": "icons/bookmark-48.png",
    "128": "icons/bookmark-128.png"
  },
  "action": {
    "default_title": "一键更新书签",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/bookmark-16.png",
      "32": "icons/bookmark-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "update-bookmark": {
      "suggested_key": { "default": "Alt+S" },
      "description": "将选定书签的网址更新为当前网页"
    }
  }
}
